#!/bin/bash
# cli3 - blank the physical display without tearing down the GUI session.
#
# This machine drives its panel via the NVIDIA proprietary driver under
# Xorg. Killing gdm/Xorg to switch to a text-mode runlevel (the old
# approach) doesn't reliably hand the framebuffer back to the console on
# this driver - the panel just freezes on the last rendered frame. So
# instead we leave the session running and tell the live X server to DPMS
# the panel off directly; NVIDIA handles that call correctly since it owns
# the display. See also: gui5 (wake the display back up).

usage() {
  cat <<'EOF'
Usage: cli3 [command]

  (no command), off   Turn the physical display off (DPMS off)
  status              Show current DPMS state
  -h, --help          Show this help
EOF
}

source "$(dirname "$(readlink -f "$0")")/_x11_env.sh"

run_xset() {
  x_env
  sudo -u "$owner" env "${envs[@]}" xset "$@"
}

cmd="${1:-}"

case "$cmd" in
  ""|off)
    run_xset dpms force off
    ;;
  status)
    run_xset q | grep -A2 '^DPMS'
    ;;
  -h|--help)
    usage
    ;;
  *)
    echo "cli3: unknown command '$cmd'" >&2
    usage >&2
    exit 1
    ;;
esac
